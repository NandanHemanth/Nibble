# Copy this file to .env and fill in the three values. Never commit .env.

# https://online.nimbleway.com/settings/api-keys
NIMBLE_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Sentry project settings > Client Keys (DSN). Leave empty to run without tracing.
SENTRY_DSN=

# A free hosted model, tried first. Groq is the default: get a key at
# https://console.groq.com/keys (no card needed). Any OpenAI-compatible
# provider works by also setting NIBBLE_LLM_BASE_URL and NIBBLE_LLM_MODEL.
# NIBBLE_LLM_API_KEY=
# NIBBLE_LLM_MODEL=openai/gpt-oss-120b
# NIBBLE_LLM_BASE_URL=https://api.groq.com/openai/v1

# A small model on this machine (via Ollama) used first, with Gemini as fallback.
# Install: https://ollama.com  then: ollama pull gemma3:4b
# NIBBLE_LOCAL_MODEL=gemma3:4b

# ---- optional ----
# Gemini model. "gemini-flash-latest" follows Google's current Flash model.
# GEMINI_MODEL=gemini-flash-latest

# Stores to price, as Nimble Extract Template names. On 2026-10-11 walmart_serp
# (about 20 s) and heb_serp (about 16 s) returned prices every time they were
# tried. kroger_serp worked once and returned an empty page twice; target_serp
# and amazon_serp returned no parsed products. Add them back if preflight shows
# them working.
# NIBBLE_STORE_TEMPLATES=walmart_serp,heb_serp

# Ask Nimble to switch each store to your ZIP before pricing. Off by default:
# the localized Walmart run did not finish within 75 s in testing.
# NIBBLE_LOCALIZE=0

# Web Search Agent effort for "Why this price?": low (about 35 s), medium (1-3 min).
# NIBBLE_AGENT_EFFORT=low

# Force sample data even when keys are set (a safe fallback on stage).
# NIBBLE_DEMO=1

# Set to 0 to keep prompts and model output out of Sentry.
# SENTRY_SEND_PROMPTS=1
